{
  "name": "portfoliost-wallets",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gen:openapi": "tsx src/gen-openapi.ts",
    "gen:types": "openapi-typescript node_modules/@marx2/contracts/openapi.yaml -o src/generated/api-types.d.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@marx2/contracts": "^1.6.34",
    "@marx2/otel": "^1.0.2",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "hono-zod-openapi": "^1.1.1",
    "import-in-the-middle": "^3.5.0",
    "jose": "^6.2.9",
    "pino": "^9.14.0",
    "postgres": "^3.4.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
