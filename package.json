{
  "name": "portfoliost-wallets",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gen:openapi": "tsx src/gen-openapi.ts",
    "gen:types": "openapi-typescript node_modules/@marx-org/contracts/openapi.yaml -o src/generated/api-types.d.ts"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@marx-org/contracts": "^1.6.79",
    "@marx-org/otel": "^1.0.5",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-prometheus": "^0.223.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-zod-openapi": "^1.1.1",
    "import-in-the-middle": "^3.5.2",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
